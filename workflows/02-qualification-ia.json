        }
      },
      "id": "0c7ecf867bdf987a0aa763c668981143",
      "name": "Enregistrer le résultat",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1340,
        80
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "return [{json:{ok:false,status:'persistence_error',request_id:$('Réserver sans doublon').first().json.request_id,message:'Le résultat ne peut pas être confirmé. Consulter le service avant une nouvelle tentative.'}}];"
      },
      "id": "93879e118c8fd2197a66585095e8d2e3",
      "name": "Persistance à vérifier",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        470
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst record = response.record ?? response;\nconst input = record.input ?? record;\nconst analysis = record.analysis ?? {};\n// RAW in Google Sheets preserves strings without evaluating spreadsheet formulas.\nconst row = {\n  demande_id: record.request_id ?? record.id ?? $('Réserver sans doublon').first().json.request_id,\n  date: record.created_at ?? record.createdAt ?? new Date().toISOString(),\n  prenom: input.first_name ?? '', nom: input.last_name ?? '', email: input.email ?? '', demande: input.message ?? '',\n  categorie: analysis.category ?? '', resume: analysis.summary ?? '',\n  informations_manquantes: (analysis.missing_information ?? []).join(' | '), brouillon_reponse: analysis.draft_reply ?? '',\n  statut: record.status ?? 'unknown', erreur: record.error?.code ?? '', modele: record.metrics?.model ?? '',\n};\nreturn [{json:{record,row,sheets_enabled:false}}];"
      },
