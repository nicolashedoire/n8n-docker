      "id": "bb7802bb7f0690f067d420ba68e0d0f4",
      "name": "Qualifier avec Ollama",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        780,
        0
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nconst reservation = $('Réserver sans doublon').first().json;\nconst out = { attempt_token: reservation.attempt_token, metrics: response.metrics ?? {} };\ntry {\n  if (typeof response.text !== 'string') throw new Error('Le modèle doit retourner un texte JSON.');\n  const analysis = JSON.parse(response.text);\n  const keys = ['category', 'summary', 'missing_information', 'draft_reply'];\n  if (!analysis || typeof analysis !== 'object' || Array.isArray(analysis) || Object.keys(analysis).sort().join('|') !== keys.sort().join('|')) throw new Error('Champs JSON inattendus ou absents.');\n  if (!['devis', 'rendez_vous', 'support', 'autre'].includes(analysis.category)) throw new Error('Catégorie invalide.');\n  if (typeof analysis.summary !== 'string' || !analysis.summary.trim() || analysis.summary.length > 2000) throw new Error('Résumé invalide.');\n  if (!Array.isArray(analysis.missing_information) || analysis.missing_information.length > 20 || !analysis.missing_information.every(x => typeof x === 'string' && x.trim() && x.length <= 300)) throw new Error('Informations manquantes invalides.');\n  if (typeof analysis.draft_reply !== 'string' || !analysis.draft_reply.trim() || analysis.draft_reply.length > 5000) throw new Error('Brouillon invalide.');\n  out.analysis = analysis;\n} catch (error) {\n  out.error = { code: 'INVALID_LLM_OUTPUT', message: error instanceof SyntaxError ? 'Le modèle a produit un JSON invalide.' : error.message };\n}\nreturn [{json:out}];"
      },
      "id": "b4b6e5e623a024b19c4ef4e7edfde537",
      "name": "Valider le JSON du modèle",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        -20
      ]
    },
    {
      "parameters": {
        "jsCode": "\nreturn [{json:{attempt_token:$('Réserver sans doublon').first().json.attempt_token,error:{code:'LLM_UNAVAILABLE',message:'Appel IA en échec après les tentatives bornées. Revue humaine nécessaire.'},metrics:{scenario:$('Normaliser la demande').first().json.input.scenario}}}];"
      },
      "id": "9eb87b35dce0c4e73d7e65af420077d9",
      "name": "Contenir la panne IA",
