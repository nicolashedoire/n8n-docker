    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\nreturn [{json:{ok:true,route:'duplicate',request_id:response.request_id,record:response.record,message:'Demande déjà reçue : résultat existant, sans nouvel appel IA.'}}];"
      },
