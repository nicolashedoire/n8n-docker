    {
      "parameters": {
        "method": "POST",
        "url": "http://qualification-api:3000/llm",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { message: $(\"Normaliser la demande\").first().json.input.message, scenario: $(\"Normaliser la demande\").first().json.input.scenario } }}",
        "options": {
