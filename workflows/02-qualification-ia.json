          "values": [
            {
              "fieldLabel": "Prénom",
              "fieldName": "first_name",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Nom",
              "fieldName": "last_name",
              "fieldType": "text",
